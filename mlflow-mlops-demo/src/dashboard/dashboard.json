{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT c.event_date, c.impressions, c.clicks, c.conversions, c.spend_usd, c.conversion_value_usd, ",
        "       COALESCE(w.wasted_spend_usd, 0) AS wasted_spend_usd ",
        "FROM ( ",
        "  SELECT event_date, SUM(impressions) AS impressions, SUM(clicks) AS clicks, ",
        "         SUM(conversions) AS conversions, SUM(spend_usd) AS spend_usd, ",
        "         SUM(conversion_value_usd) AS conversion_value_usd ",
        "  FROM gold_campaign_daily GROUP BY event_date ",
        ") c ",
        "LEFT JOIN ( ",
        "  SELECT p.event_date, SUM(p.spend_usd * greatest(0, 1 - p.actual_ctr / nullif(b.baseline_ctr, 0))) AS wasted_spend_usd ",
        "  FROM gold_ctr_predictions p ",
        "  JOIN (SELECT campaign_id, SUM(clicks) / SUM(impressions) AS baseline_ctr FROM gold_segment_ctr_daily WHERE is_drift_window = FALSE GROUP BY campaign_id) b ",
        "    ON p.campaign_id = b.campaign_id ",
        "  WHERE p.is_drift_window = TRUE AND p.is_drift_segment = TRUE GROUP BY p.event_date ",
        ") w ON c.event_date = w.event_date"
      ]
    },
    {
      "name": "ds_pred_actual",
      "displayName": "Predicted vs actual CTR by week",
      "queryLines": [
        "SELECT event_week, ",
        "       SUM(clicks_actual) / SUM(impressions) AS actual_ctr, ",
        "       SUM(pred_stale_weighted) / SUM(impressions) AS predicted_ctr_stale, ",
        "       SUM(pred_champ_weighted) / SUM(impressions) AS predicted_ctr_champion ",
        "FROM ( ",
        "  SELECT date_trunc('week', event_date) AS event_week, impressions, ",
        "         actual_ctr * impressions AS clicks_actual, ",
        "         predicted_ctr_stale * impressions AS pred_stale_weighted, ",
        "         predicted_ctr_champion * impressions AS pred_champ_weighted ",
        "  FROM gold_ctr_predictions ",
        ") GROUP BY event_week ORDER BY event_week"
      ]
    },
    {
      "name": "ds_channel_mix",
      "displayName": "Channel mix + CTR",
      "queryLines": [
        "SELECT event_week, event_date, channel, ",
        "       SUM(impressions) AS impressions, ",
        "       SUM(clicks) / SUM(impressions) AS ctr, ",
        "       SUM(spend_usd) AS spend_usd, ",
        "       MAX(is_drift_window) AS is_drift_window ",
        "FROM gold_campaign_daily ",
        "GROUP BY event_week, event_date, channel ORDER BY event_week, channel"
      ]
    },
    {
      "name": "ds_segment_gap",
      "displayName": "Segment prediction gaps",
      "queryLines": [
        "SELECT p.event_date, p.channel, p.device, p.country, p.visitor_type, p.campaign_name, p.objective, ",
        "       p.impressions, p.spend_usd, p.actual_ctr, p.predicted_ctr_stale, p.predicted_ctr_champion, ",
        "       p.ctr_gap_stale, p.ctr_gap_champion, p.is_drift_window, p.is_drift_segment, ",
        "       CASE WHEN p.is_drift_window AND p.is_drift_segment ",
        "            THEN p.spend_usd * greatest(0, 1 - p.actual_ctr / nullif(b.baseline_ctr, 0)) ELSE 0 END AS wasted_spend_usd ",
        "FROM gold_ctr_predictions p ",
        "LEFT JOIN (SELECT campaign_id, SUM(clicks) / SUM(impressions) AS baseline_ctr FROM gold_segment_ctr_daily WHERE is_drift_window = FALSE GROUP BY campaign_id) b ",
        "  ON p.campaign_id = b.campaign_id"
      ]
    }
  ],
